# Copy to .env and fill in. The server refuses to start if a value is missing or bad.

# HTTP + WebSocket port (Express and Colyseus share it). Default 8080.
PORT=8080

# MongoDB connection string.
MONGODB_URL=mongodb://127.0.0.1:27017/carrom-adda

# At least 32 characters. No fallback: generate one, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Redis for the ranked queue (spec 10).
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of allowed browser origins.
# Vite dev server, Capacitor on iOS, Capacitor on Android.
CORS_ORIGIN=http://localhost:5173,capacitor://localhost,https://localhost

# Google OAuth client IDs whose ID tokens /auth/google accepts (comma list:
# the web client, later the Android client). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_IDS=

# In-app purchases (spec 14): Google Play Billing. Set both or neither; empty =
# purchases off (POST /iap/verify answers 503).
# Every app's package name, as in Play Console (comma list, spec 16: one per
# flavor, e.g. com.carromadda.app,com.carromadda.hub). The first is used for
# clients that don't send a packageName. One service account covers them all.
PLAY_PACKAGE_NAMES=
# The service account's JSON key on ONE line (Play Console → API access →
# grant it "View financial data" + "Manage orders"). Keep it out of git.
PLAY_SERVICE_ACCOUNT_JSON=

# development | production | test
NODE_ENV=development
