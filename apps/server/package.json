{
  "name": "@carrom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carrom/protocol": "workspace:*",
    "@colyseus/core": "^0.18.29",
    "@colyseus/ws-transport": "^0.18.5",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
