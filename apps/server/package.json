{
  "name": "@carrom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carrom/bot": "workspace:*",
    "@carrom/game": "workspace:*",
    "@carrom/engine": "workspace:*",
    "@carrom/protocol": "workspace:*",
    "@carrom/rules": "workspace:*",
    "@hub/game-kit": "workspace:*",
    "@hub/callbreak": "workspace:*",
    "@hub/cards": "workspace:*",
    "@hub/ludo": "workspace:*",
    "@hub/nodipar": "workspace:*",
    "@colyseus/core": "^0.18.29",
    "@colyseus/schema": "^5.0.50",
    "@colyseus/ws-transport": "^0.18.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
