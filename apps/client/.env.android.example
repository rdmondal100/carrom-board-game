# Copy to .env.android for device builds (`pnpm android:sync`). Gitignored.
# Vite reads it with `--mode android`, on top of .env.

# The server as the phone sees it: never localhost (that is the phone itself).
# Use https: the app's page is https://localhost, and Android blocks plain http from it.
VITE_API_BASE_URL=https://api.example.com

# The Google *web* client ID (the same one as on the web). Native sign-in on
# Android asks Google for an ID token for this client, so the server's
# GOOGLE_CLIENT_IDS needs no Android entry. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
