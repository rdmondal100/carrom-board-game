# Copy to .env and fill in (Vite reads VITE_* at build time).

# Where the Carrom Adda server runs (Express + Colyseus). No trailing slash.
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth web client ID (same one listed in the server's GOOGLE_CLIENT_IDS).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
