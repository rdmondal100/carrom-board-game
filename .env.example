# Docker Compose settings. Copy to .env (never commit .env).

# At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google OAuth web client ID. Empty = Google sign-in off (server and client).
GOOGLE_CLIENT_ID=

# Optional overrides
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173,capacitor://localhost,https://localhost
# PUBLIC_API_BASE_URL=http://localhost:8080   # the URL browsers use to reach the server
